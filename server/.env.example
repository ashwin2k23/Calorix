# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ──────────────────────────────────────────────────────────────

# Port the Express server listens on (defaults to 5000 if not set)
PORT=5000

# Set to "production" on Render/cloud, leave unset or "development" locally
NODE_ENV=development

# ──────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (Render/Supabase/etc.)
# If not set, the server automatically falls back to local SQLite (calorix.db)
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ──────────────────────────────────────────────────────────────
# CORS / FRONTEND
# ──────────────────────────────────────────────────────────────

# URL of the frontend — added to the CORS allowlist
# Locally this is not needed (localhost:5173 is already allowed)
# On Render, set this to your Vercel URL: https://calorix-taupe.vercel.app
FRONTEND_URL=https://your-frontend-url.vercel.app
